# Copy to .env.vaultwarden. This is the only Compose environment file used for
# Vaultwarden application settings. Keep it private and restore it separately.
DOMAIN=https://vaultwarden.example.com
DATA_FOLDER=/data
DATABASE_URL=sqlite:///data/db.sqlite3
RSA_KEY_FILENAME=/data/rsa_key.pem
ATTACHMENTS_FOLDER=/data/attachments

WEB_VAULT_ENABLED=false

ENABLE_WEBSOCKET=false
PUSH_ENABLED=false

SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=false
EMAIL_CHANGE_ALLOWED=false
EMERGENCY_ACCESS_ALLOWED=false
PASSWORD_HINTS_ALLOWED=false
SHOW_PASSWORD_HINT=false
REQUIRE_DEVICE_EMAIL=false

# With ADMIN_TOKEN unset, the admin page remains disabled. Never set this true.
DISABLE_ADMIN_TOKEN=false
USE_SENDMAIL=false

DISABLE_ICON_DOWNLOAD=true
ICON_CACHE_TTL=0
ICON_SERVICE="internal"
HTTP_REQUEST_BLOCK_NON_GLOBAL_IPS=true
HTTP_REQUEST_BLOCK_REGEX='^.+$'

SMTP_EMBED_IMAGES=false
