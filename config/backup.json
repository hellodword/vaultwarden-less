{
  "schema_version": 1,
  "listen_address": "0.0.0.0:9090",
  "data_dir": "/data",
  "state_dir": "/state",
  "staging_dir": "/staging",
  "cache_dir": "/cache",
  "restic_binary": "/usr/local/bin/restic",
  "debounce": "30s",
  "max_wait": "2m",
  "min_interval": "5m",
  "sample_interval": "15m",
  "missing_retry": "30s",
  "target_timeout": "30m",
  "maintenance_timeout": "12h",
  "shutdown_timeout": "2m",
  "event_max_bytes": 1024,
  "event_rate_per_second": 10,
  "event_burst": 20,
  "targets": [
    {
      "name": "primary",
      "backend": "rest",
      "repository_file": "/run/secrets/primary_repository",
      "backup_credentials": {
        "password_file": "/run/secrets/primary_restic_password",
        "environment_files": {
          "RESTIC_REST_USERNAME": "/run/secrets/primary_backup_username",
          "RESTIC_REST_PASSWORD": "/run/secrets/primary_backup_password"
        }
      },
      "maintenance_credentials": {
        "password_file": "/run/secrets/primary_restic_password",
        "environment_files": {
          "RESTIC_REST_USERNAME": "/run/secrets/primary_maintenance_username",
          "RESTIC_REST_PASSWORD": "/run/secrets/primary_maintenance_password"
        }
      }
    }
  ],
  "notifiers": []
}
