# Read by Docker Compose with --env-file, not by the containers themselves.
# Copy to DEPLOYMENT_ROOT/compose.env. Edit before starting the deployment;
# run docker compose up -d again to apply changes (recreates affected services).
# Compose performs $VARIABLE/${VARIABLE} interpolation here. Use single quotes
# for literal values containing $, and do not source this file in a shell.

# Required absolute HOST path. Create its data, cache, config and credential
# directories first; bind mounts never create missing host paths automatically.
DEPLOYMENT_ROOT=/srv/vaultwarden-less

# Required tag of all three loaded product images. The release build fills this
# in; keep the bundled value unless intentionally selecting another release.
VWLESS_IMAGE_TAG=development

# Required non-root numeric IDs. All services use this identity; the operator
# must give it read/write access to data/cache and read access to configuration
# and backup credentials. Match ownership when adopting an existing data tree.
RUNTIME_UID=1000
RUNTIME_GID=1000

# HOST loopback port for the request proxy. TLS, public listeners and trusted
# forwarded headers belong to the external reverse proxy. Container port 8080
# is fixed by the product contract and is not changed by this setting.
LISTEN_PORT=8080
