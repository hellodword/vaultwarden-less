# Read by Compose's service env_file parser and passed to Vaultwarden.
# Compose removes surrounding quotes. Use single quotes for literal $ characters.
# Apply with docker compose up -d --no-deps --force-recreate --wait vaultwarden.
# Compose fixes the admin panel closed and reads settings from this environment.
WEB_VAULT_ENABLED=false

# Open signups only while provisioning individual accounts through a restricted
# entry point. Domains on the whitelist can register even when signups are closed.
SIGNUPS_ALLOWED=false
SIGNUPS_DOMAINS_WHITELIST=

# Personal accounts share the server. Nobody can create an organization.
# Existing organizations can invite people who already have an account.
ORG_CREATION_USERS=none
INVITATIONS_ALLOWED=false

# Avoid server-side icon fetches. The HTTP block additionally rejects non-global
# destination IPs in Vaultwarden HTTP clients that enforce this setting. It is
# not an inbound access rule or a firewall for restic/backup notifications.
DISABLE_ICON_DOWNLOAD=true
HTTP_REQUEST_BLOCK_NON_GLOBAL_IPS=true

# Disable password-hint storage/use and unauthenticated hint display. These
# settings do not erase hints already present in an adopted database.
PASSWORD_HINTS_ALLOWED=false
SHOW_PASSWORD_HINT=false

# Zero disables attachment uploads for personal and organization items.
USER_ATTACHMENT_LIMIT=0
ORG_ATTACHMENT_LIMIT=0

# Reject creation and editing of Sends. Existing links retain their access conditions.
SENDS_ALLOWED=false
# Disable emergency access. Existing contact records stay in the database.
EMERGENCY_ACCESS_ALLOWED=false

# Optional deployment-specific upstream settings (uncomment and replace).
# DOMAIN is the public HTTPS URL seen by clients, including any base path.
# The external reverse proxy terminates TLS. SMTP_* enables mail delivery.
# DOMAIN=https://vault.example.net
# SMTP_HOST=smtp.example.net
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_FROM=vault@example.net
# SMTP_USERNAME=replace-me
# SMTP_PASSWORD='replace-me'
# Other settings, including request/login rate limits, retain upstream defaults.
