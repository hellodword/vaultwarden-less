# Read by Compose's service env_file parser and passed to Vaultwarden.
# This file follows Compose quoting/interpolation rules, not Docker --env-file
# rules. Use single quotes for literal $ characters (for example in token hashes).
# Recreate Vaultwarden with docker compose up -d after editing this file.
# Editable settings in /data/config.json override these environment values;
# review an adopted config.json before relying on this profile.

# Minimal-feature profile. Web Vault assets are not shipped in this image.
WEB_VAULT_ENABLED=false

# An empty token disables the admin panel. Keep DISABLE_ADMIN_TOKEN=false:
# setting it to true would permit admin access without token authentication.
# If enabling admin later, use an upstream-supported Argon2 token hash and keep
# it private. See the selected Vaultwarden version's .env.template.
ADMIN_TOKEN=
DISABLE_ADMIN_TOKEN=false

# Close account creation and invitations after controlled provisioning.
# A nonempty domain whitelist permits matching signups even when SIGNUPS_ALLOWED
# is false, so keep it empty for a closed installation. Existing accounts remain.
SIGNUPS_ALLOWED=false
SIGNUPS_DOMAINS_WHITELIST=
INVITATIONS_ALLOWED=false

# Avoid server-side icon fetches. The HTTP block additionally rejects non-global
# destination IPs in Vaultwarden HTTP clients that enforce this setting. It is
# not an inbound access rule or a firewall for restic/backup notifications.
DISABLE_ICON_DOWNLOAD=true
HTTP_REQUEST_BLOCK_NON_GLOBAL_IPS=true

# Disable password-hint storage/use and unauthenticated hint display. These
# settings do not erase hints already present in an adopted database.
PASSWORD_HINTS_ALLOWED=false
SHOW_PASSWORD_HINT=false

# Disable new/modified Sends, emergency-access features and organization creation.
# These flags do not remove stored Sends, emergency contacts or organizations.
# Existing Sends are not revoked by SENDS_ALLOWED=false; delete/revoke them
# explicitly if that is intended. Existing organization membership remains.
SENDS_ALLOWED=false
EMERGENCY_ACCESS_ALLOWED=false
ORG_CREATION_USERS=none

# Optional deployment-specific upstream settings (uncomment and replace).
# DOMAIN must be the external HTTPS origin used by clients; TLS is terminated by
# the external reverse proxy. SMTP_* settings are needed only if sending mail.
# DOMAIN=https://vault.example.net
# SMTP_HOST=smtp.example.net
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_FROM=vault@example.net
# SMTP_USERNAME=replace-me
# SMTP_PASSWORD='replace-me'
# Other settings, including request/login rate limits, retain upstream defaults.
