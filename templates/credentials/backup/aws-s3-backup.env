# AWS S3 credentials for the backup worker; read with Docker --env-file syntax.
# Values are literal: no quotes, $ expansion, shell commands or bare NAME
# inheritance. Do not source this file. Keep mode 0600; restart backup to reload.

# Replace the bucket and choose a prefix dedicated to this installation. Match
# the endpoint and region to the bucket; us-east-1 is only the example region.
# Use restic's path URL form, with the bucket after the endpoint hostname.
RESTIC_REPOSITORY=s3:https://s3.us-east-1.amazonaws.com/REPLACE_WITH_AWS_S3_BUCKET/vaultwarden-less
AWS_DEFAULT_REGION=us-east-1

# Absolute CONTAINER path. Fill the matching raw password file on the host and
# retain an independent recovery copy. Maintenance uses this same password.
RESTIC_PASSWORD_FILE=/run/credentials/restic/aws-s3-repository-password.txt

# Dedicated backup principal, including permissions needed for restic locks.
# The worker never runs retention or prune. Prepare maintenance credentials as
# described in docs/operations.md before running those operations yourself.
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_S3_BACKUP_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_S3_BACKUP_SECRET_ACCESS_KEY
# For temporary AWS credentials, also supply their session token and rotate all
# three values together before expiry, then restart backup.
# AWS_SESSION_TOKEN=REPLACE_WITH_AWS_SESSION_TOKEN
