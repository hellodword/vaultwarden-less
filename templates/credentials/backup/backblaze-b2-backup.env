# Backblaze B2 credentials for the backup worker, using the S3-compatible API.
# Docker --env-file syntax: values are literal, without shell quotes or variable
# expansion. Do not source this file. Keep mode 0600; restart backup to reload.

# Replace the bucket and use a prefix dedicated to this installation. Copy the
# bucket's S3 endpoint from Backblaze; us-west-002 is only an example. Change the
# hostname and AWS_DEFAULT_REGION together to match your bucket's region.
RESTIC_REPOSITORY=s3:https://s3.us-west-002.backblazeb2.com/REPLACE_WITH_B2_BUCKET/vaultwarden-less
AWS_DEFAULT_REGION=us-west-002

# CONTAINER path to the raw restic password. This is not the B2 application key.
# Maintenance uses the same repository password; keep an independent safe copy.
RESTIC_PASSWORD_FILE=/run/credentials/restic/backblaze-b2-repository-password.txt

# S3-compatible application key: keyID maps to AWS_ACCESS_KEY_ID, applicationKey
# maps to AWS_SECRET_ACCESS_KEY. Do not use a B2 master application key here.
# Give the backup key the required object and restic lock operations; use a
# separate maintenance key for check/forget/prune.
AWS_ACCESS_KEY_ID=REPLACE_WITH_B2_BACKUP_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_B2_BACKUP_APPLICATION_KEY
