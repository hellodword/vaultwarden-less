# Read by the worker with Docker's --env-file syntax, then passed only to this
# target's restic process. Values are LITERAL: no shell quotes, $ interpolation,
# command substitution or inheritance for a bare NAME. Do not source this file.
# Restart backup after editing. Keep mode 0600 and never commit real credentials.

# Required native restic repository URL. Replace the example; use a repository
# or object prefix dedicated to this installation. Other restic backends are
# supported by replacing this URL and their native authentication variables.
RESTIC_REPOSITORY=s3:https://s3.example.invalid/vaultwarden/deployment-one

# Required password source in this template: a CONTAINER path mounted read-only.
# Put the actual password in credentials/restic/primary on the host. Keep a safe
# independent copy: the repository cannot be recovered without its password.
RESTIC_PASSWORD_FILE=/run/credentials/restic/primary

# Example S3 backup principal. Replace both placeholders; use provider-specific
# permissions for backup and lock objects. The worker never runs retention or
# prune. Use a different maintenance principal for those operations.
AWS_ACCESS_KEY_ID=REPLACE_WITH_BACKUP_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BACKUP_SECRET
