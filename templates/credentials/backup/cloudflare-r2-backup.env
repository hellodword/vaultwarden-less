# Cloudflare R2 credentials for the backup worker, using restic's S3 backend.
# Docker --env-file syntax: literal values, no shell quoting or interpolation.
# Do not source this file. Keep mode 0600; restart backup after changing it.

# Replace account ID and bucket; dedicate the prefix to this installation.
# Use the bucket's S3 API endpoint, not an r2.dev/custom public download URL.
# Jurisdiction-specific buckets may have a different endpoint; copy the exact
# S3 endpoint from the R2 dashboard. The S3 signing region for R2 is auto.
RESTIC_REPOSITORY=s3:https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com/REPLACE_WITH_R2_BUCKET/vaultwarden-less
AWS_DEFAULT_REGION=auto

# CONTAINER path to a raw repository password, not a Cloudflare API token.
# Use this same password for the matching maintenance role; keep a recovery copy.
RESTIC_PASSWORD_FILE=/run/credentials/restic/cloudflare-r2-repository-password.txt

# Use the Access Key ID and Secret Access Key issued for an R2 API token with
# the required object operations on this bucket. Do not put the API token string
# itself in these fields. Use a separate token/key pair for maintenance.
AWS_ACCESS_KEY_ID=REPLACE_WITH_R2_BACKUP_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_R2_BACKUP_SECRET_ACCESS_KEY
