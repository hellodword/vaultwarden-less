# Read only by operator-run Docker --env-file commands, never mounted into the
# backup service. Values are LITERAL: do not add shell quotes or expect variable
# expansion. Changes apply to the next maintenance command. Keep mode 0600.

# Must identify the SAME repository as backup/primary.env. Use a separate
# maintenance principal authorized for the intended check/forget/prune actions.
RESTIC_REPOSITORY=s3:https://s3.example.invalid/vaultwarden/deployment-one

# CONTAINER path, supplied by the operator command's read-only password mount.
# Both roles use the same repository password; the password file contains only
# the password, with no comments. See templates/README.md for preparation.
RESTIC_PASSWORD_FILE=/run/credentials/restic/primary

# Replace these S3 examples, or use your backend's native authentication fields.
AWS_ACCESS_KEY_ID=REPLACE_WITH_MAINTENANCE_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_MAINTENANCE_SECRET
